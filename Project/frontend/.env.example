# Leave VITE_API_URL empty for the development /api proxy.
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:4000

# Optional cloud conversation. Paste the Vapi PUBLIC key here in your local .env.
# Never place a Vapi private API key in a VITE_ variable.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
VITE_VAPI_VOICE_ID=josh
