# Phase 1 database configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=pathseeker_dev

# Required by `npm run seed`; use a private value and never commit a real password.
SEED_DEMO_PASSWORD=replace-with-a-strong-local-demo-password

# Safety guard. Production seeding is refused unless explicitly enabled.
NODE_ENV=development
ALLOW_PRODUCTION_SEED=false

# Optional: enables the live database integration test.
TEST_MONGODB_URI=
TEST_MONGODB_DB_NAME=pathseeker_test
