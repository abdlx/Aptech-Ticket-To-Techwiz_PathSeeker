NODE_ENV=production
PORT=4000

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net
MONGODB_DB_NAME=pathseeker

FRONTEND_ORIGIN=https://your-frontend.example.com

SESSION_COOKIE_NAME=ps_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none

BCRYPT_SALT_ROUNDS=12

EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=PathSeeker <verify@yourdomain.com>
EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=20

AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
