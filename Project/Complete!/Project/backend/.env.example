# ---------------------------------------------------------------------------
# Database (required — the server refuses to start without these)
# ---------------------------------------------------------------------------

# MongoDB connection string. Use a local mongodb://127.0.0.1:27017 instance
# or a hosted MongoDB Atlas URI (recommended if you don't run MongoDB locally).
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name Mongoose will connect to on the above URI.
MONGODB_DB_NAME=pathseeker

# ---------------------------------------------------------------------------
# Express API layer (Milestone 1+)
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=4000

# Comma-separated list of allowed frontend origins for CORS (credentials: true).
# Set this to your deployed frontend URL(s) when hosting the backend.
FRONTEND_ORIGIN=http://localhost:5173

# Session cookie (httpOnly). No JWT is used — sessions are looked up in MongoDB.
SESSION_COOKIE_NAME=ps_session
SESSION_TTL_DAYS=30
# true in production (HTTPS required); false for local http:// dev.
SESSION_COOKIE_SECURE=false
# lax | strict | none  (use "none" + SESSION_COOKIE_SECURE=true for cross-site prod)
SESSION_COOKIE_SAMESITE=lax

# bcrypt cost factor for password hashing (matches the seed script's cost of 12).
BCRYPT_SALT_ROUNDS=12

# Email delivery. "console" logs emails to stdout instead of sending them —
# safe for local development, no credentials required.
# YOU MUST PROVIDE THIS VALUE when switching to a real provider later.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@pathseeker.local
# For real delivery use EMAIL_PROVIDER=resend and set a verified sender + API key.
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_REPLY_TO=

# Verification code / reset link lifetimes.
VERIFICATION_TOKEN_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=20

# Rate limiting for auth endpoints (register/login/forgot-password/etc.).
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20

# ---------------------------------------------------------------------------
# Seed script (npm run seed / npm run seed:reset)
# ---------------------------------------------------------------------------

# Environment mode. Leave as "development" locally; the seed script refuses
# to run in "production" unless ALLOW_PRODUCTION_SEED=true.
NODE_ENV=development
ALLOW_PRODUCTION_SEED=false

# Password used for all demo seed users (Admin, Student, Graduate, Professional).
# Must be at least 12 characters — the seed script will refuse to run otherwise.
SEED_DEMO_PASSWORD=ChangeMe123!
UPLOAD_DIR=./uploads
